            <h3>企业收入排行 TOP 10</h3>
          </div>
          <div ref="topCompaniesChart" class="chart-container-medium"></div>
        </div>

        <!-- 支付方式分布 -->
        <div class="chart-card">
          <div class="card-header">
            <h3>支付方式分布</h3>
          </div>
          <div ref="paymentMethodChart" class="chart-container-medium"></div>
        </div>
      </div>

      <!-- 详细数据表格 -->
      <div class="table-card">
