        </div>
        <div class="filter-item">
          <label>结束日期</label>
          <input v-model="filters.endDate" type="date" />
        </div>
        <div class="filter-item">
          <label>分组方式</label>
          <select v-model="filters.groupBy">
            <option value="day">按天</option>
            <option value="week">按周</option>
            <option value="month">按月</option>
          </select>
        </div>
        <div class="filter-actions">
          <button @click="loadData" class="btn-search">查询</button>
          <button @click="resetFilters" class="btn-reset">重置</button>
        </div>
      </div>
    </div>

    <div v-if="loading" class="loading">加载中...</div>
    <div v-else class="content">
      <!-- 收入趋势图 -->
      <div class="chart-card">
        <div class="card-header">
          <h3>收入趋势分析</h3>
          <div class="legend">
            <span class="legend-item total">
              <i class="legend-dot"></i> 总收入
            </span>
            <span class="legend-item paid">
              <i class="legend-dot"></i> 已收款
            </span>
            <span class="legend-item unpaid">
              <i class="legend-dot"></i> 未收款
            </span>
          </div>
