          </table>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import * as echarts from 'echarts';
import { getOperationsRevenue, exportOperationsData } from '../../api/statistics';

export default {
  name: 'OperationsRevenue',
  data() {
    return {
      loading: false,
      filters: {
        companyId: '',
        startDate: '',
        endDate: '',
        groupBy: 'day'
      },
      revenueData: {
        trend: [],
        topCompanies: [],
        paymentMethod: []
      },
      revenueDetailData: [],
      totalStats: {
        totalRevenue: 0,
        paidRevenue: 0,
        unpaidRevenue: 0,
        waybillCount: 0
      },
      revenueTrendChart: null,
      topCompaniesChart: null,
      paymentMethodChart: null
    };
  },
  mounted() {
    // 设置默认日期范围（最近30天）
    const end = new Date();
    const start = new Date();
    start.setDate(start.getDate() - 30);
    this.filters.startDate = start.toISOString().split('T')[0];
    this.filters.endDate = end.toISOString().split('T')[0];
    
    this.loadData();
  },
  beforeUnmount() {
    if (this.revenueTrendChart) this.revenueTrendChart.dispose();
    if (this.topCompaniesChart) this.topCompaniesChart.dispose();
    if (this.paymentMethodChart) this.paymentMethodChart.dispose();
  },
  methods: {
    async loadData() {
      this.loading = true;
      try {
        const params = { ...this.filters };
        const response = await getOperationsRevenue(params);
        
        if (response.data.success) {
          this.revenueData = response.data.data;
          this.revenueDetailData = this.revenueData.trend || [];
          this.calculateTotalStats();
          
          this.$nextTick(() => {
            this.renderCharts();
          });
        }
      } catch (error) {
        console.error('加载数据失败:', error);
        alert('加载数据失败');
      } finally {
        this.loading = false;
      }
    },
    calculateTotalStats() {
      this.totalStats = this.revenueDetailData.reduce((acc, item) => {
        acc.totalRevenue += item.totalRevenue || 0;
        acc.paidRevenue += item.paidRevenue || 0;
        acc.unpaidRevenue += item.unpaidRevenue || 0;
        acc.waybillCount += item.waybillCount || 0;
        return acc;
      }, {
        totalRevenue: 0,
        paidRevenue: 0,
        unpaidRevenue: 0,
        waybillCount: 0
      });
    },
    renderCharts() {
      this.renderRevenueTrendChart();
      this.renderTopCompaniesChart();
      this.renderPaymentMethodChart();
    },
    renderRevenueTrendChart() {
      const chartDom = this.$refs.revenueTrendChart;
      if (!chartDom) return;

      if (this.revenueTrendChart) {
        this.revenueTrendChart.dispose();
      }

      this.revenueTrendChart = echarts.init(chartDom);
      const dates = this.revenueDetailData.map(item => item._id);
      const totalRevenue = this.revenueDetailData.map(item => item.totalRevenue);
      const paidRevenue = this.revenueDetailData.map(item => item.paidRevenue);
      const unpaidRevenue = this.revenueDetailData.map(item => item.unpaidRevenue);

      const option = {
        tooltip: {
          trigger: 'axis',
          axisPointer: {
            type: 'cross'
          }
        },
        grid: {
          left: '3%',
          right: '4%',
          bottom: '3%',
          containLabel: true
        },
        xAxis: {
          type: 'category',
          boundaryGap: false,
          data: dates
        },
        yAxis: {
          type: 'value',
          name: '金额（元）',
          axisLabel: {
            formatter: (value) => {
              return value >= 10000 ? (value / 10000).toFixed(1) + '万' : value;
            }
          }
        },
        series: [
          {
            name: '总收入',
            type: 'line',
            data: totalRevenue,
            smooth: true,
            itemStyle: { color: '#409eff' },
            areaStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                { offset: 0, color: 'rgba(64, 158, 255, 0.3)' },
                { offset: 1, color: 'rgba(64, 158, 255, 0.05)' }
              ])
            }
          },
          {
            name: '已收款',
            type: 'line',
            data: paidRevenue,
            smooth: true,
            itemStyle: { color: '#67c23a' }
          },
          {
            name: '未收款',
            type: 'line',
            data: unpaidRevenue,
            smooth: true,
            itemStyle: { color: '#e6a23c' }
          }
        ]
      };

      this.revenueTrendChart.setOption(option);
      window.addEventListener('resize', () => this.revenueTrendChart.resize());
    },
    renderTopCompaniesChart() {
      const chartDom = this.$refs.topCompaniesChart;
      if (!chartDom || !this.revenueData.topCompanies) return;

      if (this.topCompaniesChart) {
        this.topCompaniesChart.dispose();
      }

      this.topCompaniesChart = echarts.init(chartDom);
      const companies = this.revenueData.topCompanies.map(item => item.companyName || `企业${item._id}`);
      const revenues = this.revenueData.topCompanies.map(item => item.revenue);

      const option = {
        tooltip: {
          trigger: 'axis',
          axisPointer: {
            type: 'shadow'
          }
        },
        grid: {
          left: '3%',
          right: '4%',
          bottom: '3%',
          containLabel: true
        },
        xAxis: {
          type: 'value',
          name: '收入（元）',
          axisLabel: {
            formatter: (value) => {
              return value >= 10000 ? (value / 10000).toFixed(1) + '万' : value;
            }
          }
        },
        yAxis: {
          type: 'category',
          data: companies
        },
        series: [
          {
            name: '收入',
            type: 'bar',
            data: revenues,
            itemStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: '#667eea' },
                { offset: 1, color: '#764ba2' }
              ])
            },
            label: {
              show: true,
              position: 'right',
              formatter: (params) => {
                return params.value >= 10000 
                  ? (params.value / 10000).toFixed(1) + '万' 
                  : params.value;
              }
            }
          }
        ]
      };

      this.topCompaniesChart.setOption(option);
      window.addEventListener('resize', () => this.topCompaniesChart.resize());
    },
    renderPaymentMethodChart() {
      const chartDom = this.$refs.paymentMethodChart;
      if (!chartDom || !this.revenueData.paymentMethod) return;

      if (this.paymentMethodChart) {
        this.paymentMethodChart.dispose();
      }

      this.paymentMethodChart = echarts.init(chartDom);
      const data = this.revenueData.paymentMethod.map(item => ({
        name: item._id || '未知',
        value: item.revenue
      }));

      const option = {
        tooltip: {
          trigger: 'item',
          formatter: '{b}: ¥{c} ({d}%)'
        },
        legend: {
          orient: 'vertical',
          right: 10,
          top: 'center'
        },
        series: [
          {
            name: '支付方式',
            type: 'pie',
            radius: ['40%', '70%'],
            avoidLabelOverlap: false,
            itemStyle: {
              borderRadius: 10,
              borderColor: '#fff',
              borderWidth: 2
            },
            label: {
              show: false
            },
            emphasis: {
              label: {
                show: true,
                fontSize: 16,
                fontWeight: 'bold'
              }
            },
            data: data
          }
        ],
        color: ['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de']
      };

      this.paymentMethodChart.setOption(option);
      window.addEventListener('resize', () => this.paymentMethodChart.resize());
    },
    resetFilters() {
      const end = new Date();
      const start = new Date();
      start.setDate(start.getDate() - 30);
      this.filters = {
        companyId: '',
        startDate: start.toISOString().split('T')[0],
        endDate: end.toISOString().split('T')[0],
        groupBy: 'day'
      };
      this.loadData();
    },
    async handleExport() {
      try {
        const params = { ...this.filters, type: 'revenue' };
        const response = await exportOperationsData(params);
        
        const blob = new Blob([JSON.stringify(response.data, null, 2)], {
          type: 'application/json'
        });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `运营收入统计_${new Date().toISOString().split('T')[0]}.json`;
        link.click();
        window.URL.revokeObjectURL(url);
        
        alert('数据导出成功');
      } catch (error) {
        console.error('导出失败:', error);
        alert('导出失败');
      }
    },
    formatMoney(value) {
      if (!value) return '0.00';
      return Number(value).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    },
    getRateClass(rate) {
      if (rate >= 0.8) return 'high';
      if (rate >= 0.5) return 'medium';
      return 'low';
    }
  }
};
</script>

