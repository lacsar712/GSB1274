              </tr>
            </thead>
            <tbody>
              <tr v-for="(item, index) in revenueDetailData" :key="index">
                <td>{{ item._id }}</td>
                <td>{{ item.waybillCount }}</td>
                <td>¥{{ formatMoney(item.totalRevenue) }}</td>
                <td>¥{{ formatMoney(item.paidRevenue) }}</td>
                <td>¥{{ formatMoney(item.unpaidRevenue) }}</td>
                <td>
                  <span :class="['rate-badge', getRateClass(item.paidRevenue / item.totalRevenue)]">
                    {{ ((item.paidRevenue / item.totalRevenue) * 100).toFixed(1) }}%
                  </span>
                </td>
              </tr>
