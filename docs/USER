## 前端 API 调用

### API 文件
- **文件路径**: [`frontend/src/api/user.js`](../frontend/src/api/user.js)

### 使用示例

```javascript
import {
  getUserInfo,
  updateUserInfo,
  changePassword,
  getUserPreferences,
  updateUserPreferences
} from '@/api/user';

// 获取用户信息
const userInfo = await getUserInfo(userId);

// 更新用户信息
await updateUserInfo(userId, {
  username: 'newname',
  email: 'newemail@example.com',
  phone: '13900139000'
});

// 修改密码
await changePassword(userId, {
  oldPassword: 'old123',
  newPassword: 'new456',
  confirmPassword: 'new456'
});

// 获取用户偏好
const preferences = await getUserPreferences(userId);

// 更新用户偏好
await updateUserPreferences(userId, {
  theme: 'dark',
  language: 'zh-CN',
  notifications: {
    email: true,
    push: true,
    sms: false
  }
});
```

